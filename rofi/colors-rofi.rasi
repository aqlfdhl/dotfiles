* {
  bg0     : rgba(27, 28, 33, 0.6);
  bg1     : rgba(32, 34, 40, 0.6);
  bg2     : rgba(38, 40, 47, 0.6);
  bg3     : rgba(69, 72, 81, 0.6);
  fg0     : rgba(192, 194, 202, 0.6);
  fg1     : rgba(255, 255, 255, 1);
  fg2     : rgba(119, 123, 135, 1);
  red     : rgba(133, 136, 145, 0.6);
  green   : rgba(157, 165, 139, 0.6);
  yellow  : rgba(170, 161, 139, 1);
  blue    : rgba(146, 155, 170, 0.6);
  magenta : rgba(154, 147, 159, 1);
  cyan    : rgba(143, 165, 162, 1); 

// bg0     : #1B1C21
// bg1     : #202228
// bg2     : #26282F
// bg3     : #454851
// fg0     : #C0C2CA
// fg1     : #FFFFFF
// fg2     : #777B87
// red     : #858891
// green   : #9DA58B
// yellow  : #AAA18B
// blue    : #929BAA
// magenta : #9A939F
// cyan    : #8FA5A2

  accent: @fg0;
  urgent: @yellow;

  background-color : transparent;
  text-color       : @fg0;
}
