configuration {
    show-icons: true;
    hover-select:          true;
    me-select-entry:       "";
    me-accept-entry:       "!MousePrimary";
    kb-cancel:             "Escape,MousePrimary";
}
@import "colors-rofi.rasi"
* {
  font:   "Hack Nerd Font Propo 19";
  margin  : 0;
  padding : 0;
  spacing : 0;
}

element-icon, element-text, scrollbar {
  cursor: pointer;
}

window {
  location : center;
  width    : 580px;
  x-offset : 4px;
  y-offset : 26px;

  background-color: @bg1;
  border: 2px;
  border-color: @bg3;
  border-radius: 8px;
}

inputbar {
  spacing  : 8px;
  padding  : 4px 8px;
  children : [ icon-search, entry ];

  background-color: @bg0;
}

icon-search, entry, element-icon, element-text {
  vertical-align: 0.5;
}

icon-search {
  expand   : false;
  filename : "search-symbolic";
  size     : 14px;
}

textbox {
  padding          : 4px 8px;
  background-color : @bg2;
}

element {
  padding : 4px 8px;
  spacing : 8px;
}

element normal {
  text-color: @fg1;
}

element selected {
  text-color       : @bg0;
  background-color : @accent;
  border-radius: 8px;
}

element selected urgent {
  background-color: @urgent;
}

element-icon {
  size: 1em;
  vertical-align: 0.5;
}

element-text {
  text-color: inherit;
}

scrollbar {
  handle-width : 4px;
  handle-color : @fg2;
  padding      : 0 4px;
}

entry {
    placeholder: "App Launcher";
    horizontal-align: 0.5;
    cursor-width: 0;
    placeholder-color: @fg2;
}
