include colors-kitty.conf
# Font settings
font_family      MesloLGS NF
font_size        10.0

#Rules
confirm_os_window_close 0

# Window layout & padding
hide_window_decorations yes
window_padding_width 10
background_opacity   0.7

# Base colors (Primary)
foreground #a9b1d6
background #000000

# Normal colors
color0 #32344a
color1 #f7768e
color2 #9ece6a
color3 #e0af68
color4 #7aa2f7
color5 #ad8ee6
color6 #2e7d64
color7 #787c99

# Bright colors
color8  #444b6a
color9  #ff7a93
color10 #b9f27c
color11 #ff9e64
color12 #7da6ff
color13 #bb9af7
color14 #4f969a
color15 #acb0d0
