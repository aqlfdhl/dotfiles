{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,
    "modules-left": [
        "clock",
        "hyprland/workspaces",
        "custom/spotify"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/pacman",
        "tray",
        "network",
        "memory",
        "cpu",
        "backlight",
        "pulseaudio",
        "pulseaudio#microphone",
        "battery"
    ],

    "hyprland/window": {
        "format":" {}",
	      "max-length": 30,
        "on-click": "rofi -show drun"
    },
    
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{}"
    },

    "tray": {
        "icon-size": 13,
        "spacing": 10
    },

    "clock": {
        "format": "{:%A  %m-%d-%Y  %H:%M:%S}",
        "interval": 1,
        "rotate": 0,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click": "mode",
            "format": {
                "months": "<span color='#F7C58A'><b>{}</b></span>",
                "weekdays": "<span color='#F7C58A'><b>{}</b></span>",
                "today": "<span color='#F7C58A'><b>{}</b></span>",
                "days": "<span color='#627585'><b>{}</b></span>"
            }
        }
    },

   "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", "󰃠"],
    "scroll-step": 5,
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": false
    },

    "custom/brightness": {
        "format": "{icon} {text}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "exec": "~/.config/waybar/brightness-safe.sh get",
        "on-scroll-up": "~/.config/waybar/brightness-safe.sh up",
        "on-scroll-down": "~/.config/waybar/brightness-safe.sh down",
        "interval": 5,
        "signal": 1,
        "return-type": "json",
        "tooltip": false
    },

    "custom/spotify": {
        "format": " {}",
        "escape": true,
        "interval": 2,
        "max-length": 24,
        "smooth-scrolling-threshold": 20, // This value was tested using a trackpad, it should be lowered if using a mouse.
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "exec": "$HOME/.local/bin/spotify_status.sh" , // Script in resources/custom_modules folder
    },

    "custom/pacman": {
        "format": "{} ",
        "interval": "once",
        "exec": "checkupdates | wc -l",
        "on-click": "WIN=$(hyprctl clients -j | jq -r '.[] | select(.class == \"general-float\") | .address' | head -n1); if [ -n \"$WIN\" ]; then hyprctl dispatch 'hl.dsp.window.close({ address = \"'$WIN'\" })'; else kitty --class general-float --hold --title general-float bash -c 'checkupdates && sudo pacman -Syu'; fi", 
        "signal": 8,
        "tooltip-format": "{} Update Available"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "tooltip": true,
        "format-muted": " Muted",
        "on-click": "pamixer -t",
        "on-click-right": "pgrep wiremix >/dev/null 2>&1 && killall wiremix || kitty --title wiremix-float wiremix",
        "on-scroll-up": "pamixer -i 1",
        "on-scroll-down": "pamixer -d 1",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["","", "", ""],
        }
    },

    "pulseaudio#microphone": {
        "tooltip": true,
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " Muted",
        "on-click": "pamixer --default-source -t",
        "on-click-right": "pgrep wiremix >/dev/null 2>&1 && killall wiremix || kitty --title wiremix-float wiremix",
        "on-scroll-up": "pamixer --default-source -i 5",
        "on-scroll-down": "pamixer --default-source -d 5",
        "scroll-step": 5
    },

    "memory": {
        "states": {
            "c": 90, // critical
            "h": 60, // high
            "m": 30 // medium
        },
        "interval": 10,
        //"format": "󰾆 {used}GB",
        "format-m": "󰾅 {used}GB",
        "format-h": "󰓅 {used}GB",
        "format-c": " {used}GB",
        "format": "󰾆 {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "󰾆 {percentage}%\n {used:0.1f}GB/{total:0.1f}GB",
        "on-click-right": "pgrep btop >/dev/null 2>&1 && killall btop || kitty --title btop-float btop"
    },

    "cpu": {
        "interval": 10,
        "format": "󰍛 {usage}%",
        "format-alt": "{icon0}{icon1}{icon2}{icon3}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "on-click-right": "pgrep btop >/dev/null 2>&1 && killall btop || kitty --title btop-float btop"

    },

    "network": {
        "tooltip": true,
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪",
        "tooltip-format-disconnected": "Disconnected",
        "format-alt": "<span foreground='#D99D94'> {bandwidthDownBytes}</span> <span foreground='#F7C58A'> {bandwidthUpBytes}</span>",
        "interval": 2
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "🇺🇸",
        "format-ru": "🇷🇺",
        "keyboard-name": "at-translated-set-2-keyboard",
        "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
    } 
}
