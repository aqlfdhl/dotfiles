{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
        "1": "cyan"},
    "padding": {
      "top": 1,
      "left": 2,
      "right": 1
    }
  },

  "display": {
    // Space + arrow as the key→value separator
    "separator": " : ",
    "key": {
      "width": 18
    },
    "color": {
      "keys":      "blue",
      "title":     "cyan",
      "separator": "blue"
    },
    "brightColor": true
  },

  "modules": [

    // ╭─ Identity ─────────────────────────────────────╮
    {
      "type": "title",
      "color": {
        "user": "bright_cyan",
        "at":   "blue",
        "host": "bright_blue"
      }
    },
    {
      "type": "separator",
      "string": "──────────────────────────────────────"
    },
    "breal",
    {
      "type": "os",
      "key":      "╭  OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key":      "├  Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key":      "├  Packages",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key":      "╰  Shell",
      "keyColor": "cyan"
    },

    // ╭─ Desktop ───────────────────────────────────────╮
        "break",
    
    {
      "type": "de",
      "key":      "╭  DE",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key":      "╭  WM",
      "keyColor": "magenta"
    },
    {
      "type": "wmtheme",
      "key":      "├  WM Theme",
      "keyColor": "magenta"
    },
    {
      "type": "lm",
      "key":      "├  Login",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key":      "├  Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "font",
      "key":      "╰  Font",
      "keyColor": "magenta"
    },

    // ╭─ Hardware ──────────────────────────────────────╮
        "break",
    {
      "type": "host",
      "key":      "╭  Host",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key":      "├  CPU",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key":      "├  GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key":      "├  RAM",
      "keyColor": "yellow"
    },
    {
      "type": "swap",
      "key":      "├  Swap",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key":      "├  Disk",
      "keyColor": "yellow"
    },
    {
      "type": "battery",
      "key":      "├  Battery",
      "keyColor": "yellow"
    },
    {
      "type": "poweradapter",
      "key":      "├  Charger",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key":      "├  Display",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key":      "├  Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "locale",
      "key":      "╰  Locale",
      "keyColor": "yellow"
    },

    // ╭─ Colors ────────────────────────────────────────╮
        "break",
    {
      "type": "colors",
      "symbol":      "circle",
      "paddingLeft": 2
    }

  ]
}
